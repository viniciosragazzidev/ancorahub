    {
      "id": "frontend",
      "keywords": ["ui", "sidebar", "design", "tela", "componente", "acessibilidade", "motion"],
      "paths": ["src/components", "src/app"],
      "documents": ["docs/ux/UX_REDESIGN_CONTRACT.md", "docs/ux/UX_REDESIGN_CONTROL.md"]
    },
    {
      "id": "database-security",
      "keywords": ["banco", "drizzle", "tenant", "permissão", "permissao", "lgpd", "migração", "migracao"],
      "paths": ["src/shared/db", "drizzle", "src/features"],

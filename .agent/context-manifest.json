    },
    {
      "id": "ai-agent",
      "keywords": ["ia", "ai", "whatsapp", "quick reply", "qualificação", "qualificacao", "handoff"],
      "paths": ["src/features/ai-agent", "src/features/ai-qualification"],
      "documents": ["docs/architecture/modules/ai-agent.md", "docs/agent/SECURITY_RULES.md", "docs/decision-log.md"]
    },
    {
      "id": "communication",
      "keywords": ["meta", "outbox", "template", "canal", "webhook", "whatsapp", "notificação", "notificacao"],
      "paths": ["src/features/communication-channels", "src/features/notifications", "services/whatsapp-api"],

      "keywords": ["extensão", "extensao", "assistant", "whatsapp web", "mv3"],
      "paths": ["apps/browser-extension", "src/features/browser-extension", "src/app/api/extension"],
      "documents": ["docs/architecture/modules/browser-extension.md", "docs/agent/SECURITY_RULES.md"]

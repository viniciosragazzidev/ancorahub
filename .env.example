# Copy to .env.local for local development. Never commit real secrets.

# Server-only PostgreSQL connection. For Supabase, prefer the pooler connection string.
# SUPABASE_DB_URL takes precedence over DATABASE_URL during the migration period.
SUPABASE_DB_URL=
DATABASE_URL=

# Optional managed infrastructure integrations. Keep all values server-only.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SENTRY_DSN=
AXIOM_DATASET=
AXIOM_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# BetterAuth server configuration. BETTER_AUTH_SECRET must be a high-entropy secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public application origin only. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser/session clients. The publishable key is safe for client use;
# never add a service-role key to NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=documents

# One-time, server-only bootstrap inputs. Use fictitious data in development.
# BOOTSTRAP_TENANT_NAME=Corretora Exemplo
# BOOTSTRAP_TENANT_SLUG=corretora-exemplo
# BOOTSTRAP_BRANCH_NAME=Matriz
# BOOTSTRAP_DIRECTOR_NAME=Diretor Exemplo
# BOOTSTRAP_DIRECTOR_EMAIL=diretor@example.test
# BOOTSTRAP_DIRECTOR_PASSWORD=replace-with-a-strong-password
# PWA Push Notifications
# Generate VAPID keys via: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe for client use (public key only).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

CRON_SECRET=change-me
# Meta Lead Ads webhook (server-only; configure after Meta App Review)
META_LEAD_WEBHOOK_VERIFY_TOKEN=change-me
# Marketing/Lead Ads uses an OAuth authorization isolated from WhatsApp.
# Never reuse a WhatsApp connection token for Marketing data.
META_LEAD_ADS_APP_ID=
META_LEAD_ADS_APP_SECRET=
META_LEAD_ADS_TOKEN_ENCRYPTION_KEY=
META_LEAD_ADS_REDIRECT_URI=http://localhost:3000/api/integrations/meta/lead-ads/callback
NEXT_PUBLIC_META_LEAD_ADS_APP_ID=
META_GRAPH_API_VERSION=v25.0

# WhatsApp Tech Provider / Embedded Signup. Only App ID and Config ID are public.
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_TOKEN_ENCRYPTION_KEY=
META_WHATSAPP_GRAPH_API_VERSION=v25.0
NEXT_PUBLIC_META_WHATSAPP_APP_ID=
NEXT_PUBLIC_META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# The existing Meta app secret is reused for X-Hub-Signature-256 verification.
OPENWA_BASE_URL=http://localhost:2785
OPENWA_WEBHOOK_URL=http://host.docker.internal:3000
OPENWA_PORT=2785
OPENWA_API_KEY=change-me
OPENWA_WEBHOOK_SECRET=change-me-webhook-secret

# Optional external quote application. The lead page opens this URL with ?leadId=<id>
# after validating the authenticated user's tenant/branch/ownership on the server.
EXTERNAL_QUOTE_APP_URL=

# ── AI providers (agente de WhatsApp e simulador) ───────────────────────────
# O roteador automático tenta os provedores em ordem (AI_PROVIDER_ORDER). Se um
# falhar por créditos, rate-limit ou indisponibilidade, o próximo assume — a IA
# nunca fica sem resposta enquanto houver ao menos uma chave configurada.
#
# GROQ: tier gratuito generoso e rápido (recomendado como primário).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER: usa modelos gratuitos (:free) por padrão; troque por um modelo pago
# (ex.: gpt-4o-mini) quando a conta tiver créditos.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free
# Ordem de tentativa do roteador (separada por vírgula).
AI_PROVIDER_ORDER=groq,openrouter

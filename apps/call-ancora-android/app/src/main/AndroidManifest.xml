<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Discar sem o corretor tocar em "ligar" no discador do sistema. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Conversa com o AncoraHub (pareamento e fila do CRM). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ler o QR de pareamento. Pedida só na hora de ler. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Ler o estado do telefone (usado pelo papel de discador padrão). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Notificação fixa da ligação (Android 13+ pede ao usuário). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Abrir a tela de chamada recebida com o celular bloqueado (Android 14+ confere). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Serviço de chamada em primeiro plano, tipo ligação telefônica. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallAncora">

        <!-- Tela principal. Os filtros DIAL e VIEW tel: são exigidos para o
             app poder virar o discador padrão (RoleManager.ROLE_DIALER). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Tela de chamada mínima (obrigatória para o discador padrão).
             Aparece por cima da tela de bloqueio. -->
        <activity
            android:name=".InCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:theme="@style/Theme.CallAncora.InCall"
            android:taskAffinity="br.com.ancorasaude.callancora.incall"
            android:turnScreenOn="true" />

        <!-- O sistema liga a este serviço quando o app é o discador padrão e
             entrega cada ligação (estados e DisconnectCause). -->
        <service
            android:name=".CallService"
            android:exported="true"
            android:foregroundServiceType="phoneCall"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Leitor de QR do ZXing: segue a orientação do celular (retrato). -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <!-- Botões da notificação da ligação (Atender, Recusar, Desligar). -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
    </application>
</manifest>

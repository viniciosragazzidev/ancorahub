<?xml version="1.0" encoding="utf-8"?>
<!-- Tela da prova do discador, no visual do AncoraHub Lite.
     android:tag diz qual fonte aplicar (ver AppFonts): font400, font500, font600 ou mono. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/call_ancora" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:tag="font600"
                    android:text="Call Âncora"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif"
                    android:tag="font400"
                    android:text="Teste do discador da Âncora"
                    android:textColor="@color/fog"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- "Preparar o celular": checklist de acesso ao sistema de ligações.
             Some quando todos os itens estão liberados. -->
        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="126dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/ancora_gold" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="46dp"
                    android:layout_marginEnd="100dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/ancora_gold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxWidth="200dp"
                        android:tag="font600"
                        android:text="Preparar o celular"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.8"
                        android:fontFamily="sans-serif"
                        android:lineSpacingMultiplier="1.2"
                        android:maxWidth="190dp"
                        android:tag="font400"
                        android:text="Para discar sozinho e registrar cada ligação, libere estes itens. Ligar só funciona com todos marcados."
                        android:textColor="@color/white"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/btnRole"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="2dp"
                        android:tag="font600"
                        android:text="Liberar o próximo"
                        android:textColor="@color/ancora_navy"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="-6dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/mascote_boas_vindas" />
            </FrameLayout>

            <!-- Itens criados no código (MainActivity.renderReadiness). -->
            <LinearLayout
                android:id="@+id/readinessList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp" />
        </LinearLayout>

        <!-- Situação do discador padrão -->
        <TextView
            android:id="@+id/chipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_warn"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:tag="font600"
            android:text="● Ainda não é o discador padrão"
            android:textColor="@color/amber_ink"
            android:textSize="12sp" />

        <!-- Número e cenário -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:tag="font500"
                android:text="Número para o teste"
                android:textColor="@color/fog"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="(21) 9____-____"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:tag="font600"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/placeholder"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font500"
                    android:text="com DDD"
                    android:textColor="@color/fog"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scenarioSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font500"
                    android:text="O que você espera que aconteça?"
                    android:textColor="@color/fog"
                    android:textSize="12sp" />

                <!-- ChipGroup só organiza em linhas; a seleção é feita no código. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/scenarioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp">

                    <TextView
                        android:id="@+id/scAtendida"
                        style="@style/CallAncora.ScenarioChip"
                        android:text="Atendida" />

                    <TextView
                        android:id="@+id/scNaoAtende"
                        style="@style/CallAncora.ScenarioChip"
                        android:text="Não atende" />

                    <TextView
                        android:id="@+id/scCaixaPostal"
                        style="@style/CallAncora.ScenarioChip"
                        android:text="Caixa postal" />

                    <TextView
                        android:id="@+id/scOcupado"
                        style="@style/CallAncora.ScenarioChip"
                        android:text="Ocupado" />

                    <TextView
                        android:id="@+id/scDesliga"
                        style="@style/CallAncora.ScenarioChip"
                        android:text="Desliga na hora" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </LinearLayout>

        <!-- Fila de teste: substituta local da fila do CRM (etapa 2). -->
        <LinearLayout
            android:id="@+id/queueCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font600"
                    android:text="Fila de teste"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvQueueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font500"
                    android:textColor="@color/fog"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:tag="font400"
                android:text="Cole ou digite números, um por linha."
                android:textColor="@color/fog"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etQueue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="(21) 99999-0000\n(21) 98888-7777"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLines="6"
                android:minLines="2"
                android:padding="12dp"
                android:tag="font400"
                android:textColor="@color/ink"
                android:textColorHint="@color/placeholder"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnQueueAdd"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:tag="font600"
                    android:text="Adicionar à fila"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnQueueClear"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pill_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:tag="font600"
                    android:text="Limpar"
                    android:textColor="@color/steel"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Números da fila, criados no código (MainActivity.renderQueue). -->
            <LinearLayout
                android:id="@+id/queueList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:tag="font600"
                        android:text="Discagem automática"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:tag="font400"
                        android:text="Quando a ligação cai, liga para o próximo em 3 s."
                        android:textColor="@color/fog"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ligar -->
        <LinearLayout
            android:id="@+id/btnCall"
            android:layout_width="match_parent"
            android:layout_height="59dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_call_button"
            android:clickable="true"
            android:contentDescription="Ligar"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="3dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_phone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:id="@+id/tvCallLabel"
                android:importantForAccessibility="no"
                android:tag="font600"
                android:text="Ligar"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Sessão de ligações em andamento, pausada ou concluída. -->
        <LinearLayout
            android:id="@+id/sessionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/sessionDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/ancora_green" />

                <TextView
                    android:id="@+id/tvSessionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font600"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSessionDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:tag="font400"
                android:textColor="@color/fog"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvSessionStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:tag="font500"
                android:textColor="@color/steel"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSessionToggle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_ink"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:tag="font600"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSessionEnd"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:tag="font600"
                    android:text="Segure para encerrar"
                    android:textColor="@color/hangup_red"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Última ligação -->
        <LinearLayout
            android:id="@+id/lastCallHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:tag="font600"
                android:text="Última ligação"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:padding="4dp"
                android:tag="font600"
                android:textColor="@color/ancora_blue"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Linhas da linha do tempo são criadas no código (TimelineRow). -->
        <LinearLayout
            android:id="@+id/timelineCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp" />

        <!-- Vazio -->
        <LinearLayout
            android:id="@+id/emptyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/mascote_repouso" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:tag="font400"
                android:text="Nenhuma ligação ainda.\nFaça um teste e cada etapa aparece aqui."
                android:textColor="@color/fog"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Copiar / Enviar: sempre o registro técnico completo -->
        <LinearLayout
            android:id="@+id/logActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_outline"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:tag="font600"
                android:text="Copiar"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_ink"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:tag="font600"
                android:text="Enviar registro"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

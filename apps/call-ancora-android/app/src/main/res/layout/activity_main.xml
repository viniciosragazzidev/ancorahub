<?xml version="1.0" encoding="utf-8"?>
<!-- Call Âncora, no visual do AncoraHub Lite. Uma tela por vez:
     conectar (QR) → boas-vindas → (preparar o celular, só se faltar algo) → ligações.
     Nenhuma configuração aqui: regras e limites ficam com o diretor no AncoraHub.
     android:tag diz qual fonte aplicar (ver AppFonts): font400, font500, font600 ou mono. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/call_ancora" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:tag="font600"
                android:text="Call Âncora"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnExit"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:tag="font600"
                android:text="Sair"
                android:textColor="@color/fog"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 1. Conectar: só o QR -->
        <LinearLayout
            android:id="@+id/connectView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/mascote_boas_vindas" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:tag="font600"
                android:text="Conecte ao AncoraHub"
                android:textColor="@color/ink"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:maxWidth="300dp"
                android:tag="font400"
                android:text="No computador, abra o Call Âncora, toque em Iniciar e leia o QR com este celular."
                android:textColor="@color/fog"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/btnScan"
                android:layout_width="match_parent"
                android:layout_height="59dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_call_button"
                android:clickable="true"
                android:contentDescription="Ler QR code"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:tag="font600"
                    android:text="Ler QR code"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvConnectError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:tag="font500"
                android:textColor="@color/hangup_red"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 2. Boas-vindas com o nome do corretor -->
        <LinearLayout
            android:id="@+id/welcomeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/welcomeMascot"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/mascote_boas_vindas" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:tag="font600"
                android:textColor="@color/ink"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:id="@+id/tvWelcomeSub"
                android:tag="font400"
                android:text="Celular conectado. Bora para as ligações."
                android:textColor="@color/fog"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Preparar o celular: só aparece se faltar alguma permissão para ligar -->
        <LinearLayout
            android:id="@+id/prepareView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font600"
                    android:text="Antes de ligar, libere o celular"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnRole"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="2dp"
                    android:tag="font600"
                    android:text="Liberar o próximo"
                    android:textColor="@color/ancora_navy"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Itens criados no código (MainActivity.renderReadiness). -->
            <LinearLayout
                android:id="@+id/readinessList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp" />
        </LinearLayout>

        <!-- 3. Ligações: contato ativo, feedback, contador, botão e próximo contato -->
        <LinearLayout
            android:id="@+id/callView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/currentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font500"
                    android:textColor="@color/fog"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font600"
                    android:textColor="@color/ink"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font500"
                    android:textColor="@color/steel"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/stateRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/stateDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/dot_neutral" />

                    <TextView
                        android:id="@+id/tvState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:tag="font600"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Feedback do contato, depois da ligação atendida -->
                <LinearLayout
                    android:id="@+id/feedbackView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:tag="font600"
                        android:text="Como foi a conversa?"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnInterested"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_call_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingBottom="3dp"
                            android:tag="font600"
                            android:text="Com interesse"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/btnNotInterested"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:tag="font600"
                            android:text="Sem interesse"
                            android:textColor="@color/ink"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnVoicemail"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:tag="font600"
                            android:text="Caixa postal"
                            android:textColor="@color/steel"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/btnNoAnswer"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:tag="font600"
                            android:text="Não atendeu"
                            android:textColor="@color/steel"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/btnWrongNumber"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:tag="font600"
                            android:text="Número errado"
                            android:textColor="@color/steel"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Contador para a próxima ligação -->
                <LinearLayout
                    android:id="@+id/countdownView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_summary"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:tag="font500"
                        android:text="Próxima ligação em"
                        android:textColor="@color/fog"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:tag="font600"
                        android:textColor="@color/ink"
                        android:textSize="40sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCall"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_call_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_phone" />

                    <TextView
                        android:id="@+id/tvCallLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:tag="font600"
                        android:text="Começar ligação"
                        android:textColor="@color/white"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingMultiplier="1.15"
                    android:tag="font400"
                    android:textColor="@color/fog"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Próximo contato -->
            <LinearLayout
                android:id="@+id/nextCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font500"
                    android:text="Próximo contato"
                    android:textColor="@color/fog"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvNextName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font600"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvNextNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="font500"
                    android:textColor="@color/steel"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

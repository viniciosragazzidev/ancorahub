{
  "manifest_version": 3,
  "name": "AncoraHub Assistant",
  "version": "0.2.3",
  "description": "Painel contextual do AncoraHub para o WhatsApp Web.",
  "permissions": ["storage", "tabs", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://crm.ancorasaude.cloud/*"],
  "background": { "service_worker": "background-service-worker.js" },
  "icons": {
    "16": "icons/ancorahub-16.png",
    "48": "icons/ancorahub-48.png",
    "128": "icons/ancorahub-128.png"
  },
  "action": { "default_title": "AncoraHub Assistant", "default_popup": "popup/index.html", "default_icon": { "16": "icons/ancorahub-16.png", "32": "icons/ancorahub-32.png" } },
  "content_scripts": [{ "matches": ["https://web.whatsapp.com/*"], "js": ["content-index.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}

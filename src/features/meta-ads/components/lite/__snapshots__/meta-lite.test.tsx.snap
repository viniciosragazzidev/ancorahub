exports[`telas Meta com a chave desligada > campanhas e detalhe preservam o HTML legado 2`] = `"<div class="space-y-6"><div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-border/60 pb-4"><div><div class="flex items-center gap-2"><span transition="[object Object]" class="relative inline-flex shrink-0 items-center justify-center overflow-hidden border tabular-nums select-none transition-colors duration-[var(--duration-fast)] h-6 gap-1.5 px-2 whitespace-nowrap rounded-full font-medium border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 text-[10px]"><span class="relative z-10 inline-flex overflow-hidden"><span data-badge-label="true" variants="[object Object]" initial="initial" animate="animate" exit="exit" class="inline-flex items-center gap-1.5">Veiculação ativa na Meta</span></span></span><span class="font-mono text-xs text-muted-foreground">ID: 120210004500000</span></div><h1 class="text-2xl font-bold tracking-tight mt-1">[PF] Amil S380 Nacional, leads qualificados zona oeste RJ (outubro)</h1><p class="text-xs text-muted-foreground mt-0.5">Objetivo: <strong class="font-semibold text-foreground">LEAD_GENERATION</strong></p></div><div class="flex items-center gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5 text-xs" href="/marketing/campanhas">Voltar para Campanhas</a></div></div><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] border p-[var(--size-spacing-05)] border-border/70 bg-card shadow-none rounded-xl"><div data-slot="card-header" class="group/card-header auto-rows-min p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] flex flex-row items-center justify-between gap-4 border-b border-border/50 pb-3.5"><div class="flex items-center gap-2.5"><div class="flex size-8 items-center justify-center rounded-lg bg-primary/10 text-primary"><span class="inline-flex shrink-0 items-center justify-center size-4" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M15.1312 2.5C14.1462 2.17555 13.0936 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 10.9548 21.8396 9.94704 21.5422 9" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M17 12C17 14.7614 14.7614 17 12 17C9.23858 17 7 14.7614 7 12C7 9.23858 9.23858 7 12 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.5 4.5L12 12M19.5 4.5V2M19.5 4.5H22" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path></svg></span></div><div><div data-slot="card-title" class="font-sans tracking-tight text-foreground text-sm font-bold">Fila de Distribuição dos Leads</div><div data-slot="card-description" class="font-sans text-muted-foreground text-xs">Defina para qual fila os novos leads gerados por esta campanha serão direcionados automaticamente.</div></div></div></div><div data-slot="card-content" class="p-4"><div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border/70 bg-muted/20 px-3 py-2.5"><div class="flex items-center gap-2"><span class="inline-flex shrink-0 items-center justify-center size-4 text-primary" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12Z" stroke="currentColor" stroke-width="1.5"></path><path d="M8 12.5L10.5 15L16 9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span><div><p class="text-xs font-semibold text-foreground">Captura no CRM</p><p class="text-[11px] text-muted-foreground">Anúncios e formulários desta campanha herdam esta configuração.</p></div></div><div class="flex items-center gap-2"><span class="text-xs text-muted-foreground">Ativa</span><span data-checked="" role="switch" tabindex="0" id="base-ui-_r_1_" aria-checked="true" data-slot="switch" aria-label="Pausar captura da campanha" class="peer inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors duration-[var(--motion-duration-fast)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-50 data-checked:bg-primary data-unchecked:bg-muted"><span data-checked="" data-slot="switch-thumb" class="pointer-events-none block h-4 w-4 rounded-full bg-background shadow-[var(--shadow-xs)] ring-0 transition-transform duration-[var(--motion-duration-fast)] data-checked:translate-x-4 data-unchecked:translate-x-0"></span></span><input id
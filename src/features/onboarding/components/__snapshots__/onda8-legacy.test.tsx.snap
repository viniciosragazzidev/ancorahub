4 8.90297 7.80389C10.23 8.06073 10.5779 7.71289 11.8013 6.48949Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path><path d="M2.5 21.5L7.5 16.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M8.5 21.5L10.5 19.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M2.5 15.5L4.5 13.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M17.125 7H17M17.25 7C17.25 7.13807 17.1381 7.25 17 7.25C16.8619 7.25 16.75 7.13807 16.75 7C16.75 6.86193 16.8619 6.75 17 6.75C17.1381 6.75 17.25 6.86193 17.25 7Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span><span class="truncate">Integração via Webhook (Landing Page)</span></button></nav></div></aside><div class="min-w-0"><div class="mb-5 flex items-center justify-between gap-3"><div><p class="text-sm font-medium">Seu guia de trabalho</p><p class="mt-1 text-xs text-muted-foreground">Mostrando 12 temas para Diretor.</p></div></div><div class="space-y-6"><article id="primeiros-passos" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M11.8013 6.48949L13.2869 5.00392C14.9596 3.3312 17.1495 2.63737 19.4671 2.52399C20.3686 2.47989 20.8193 2.45784 21.1807 2.81928C21.5422 3.18071 21.5201 3.63143 21.476 4.53289C21.3626 6.8505 20.6688 9.04042 18.9961 10.7131L17.5105 12.1987C16.2871 13.4221 15.9393 13.77 16.1961 15.097C16.4496 16.1107 16.6949 17.0923 15.9578 17.8294C15.0637 18.7235 14.2481 18.7235 13.354 17.8294L6.17058 10.646C5.27649 9.75188 5.27646 8.9363 6.17058 8.04219C6.90767 7.30509 7.88929 7.55044 8.90297 7.80389C10.23 8.06073 10.5779 7.71289 11.8013 6.48949Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path><path d="M2.5 21.5L7.5 16.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M8.5 21.5L10.5 19.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M2.5 15.5L4.5 13.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M17.125 7H17M17.25 7C17.25 7.13807 17.1381 7.25 17 7.25C16.8619 7.25 16.75 7.13807 16.75 7C16.75 6.86193 16.8619 6.75 17 6.75C17.1381 6.75 17.25 6.86193 17.25 7Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Comece aqui</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Comece por aqui</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Entenda o caminho mais simples para colocar sua corretora em operação e saber onde cada tarefa acontece.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">01</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Confira seu espaço de trabalho</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Veja o nome e a identidade da sua corretora no menu. O que você enxerga depende do seu papel e da sua carteira.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Siga a ordem do dia</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Comece por Conversas, Leads ou Tarefas. Essas áreas mostram o que precisa de atenção e qual é o próximo passo.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Use o ícone de ajuda quando precisar</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Este guia explica cada área em linguagem simples. Você pode pesquisar uma palavra ou voltar ao sumário a qualquer momento.</p></div></li></ol><div class="mt-5 rounded-xl border border-primary/15 bg-primary/[0.05] px-4 py-3 text-sm leading-6 text-muted-foreground"><span class="font-medium text-foreground">Dica prática: </span>Se você acabou de entrar, não precisa conhecer tudo: comece pela sua fila e avance uma ação por vez.</div><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/dashboard">Abrir resumo<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/settings">Abrir configurações<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="leads" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5" animate="[object Object]" variants="[object Object]"></circle><path d="M20 21C20 16.5817 16.4183 13 12 13C7.58172 13 4 16.5817 4 21" variants="[object Object]" transition="[object Object]" animate="[object Object]"></path></svg></div></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Atendimento</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Leads: sua fila de oportunidades</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Cadastre, encontre e avance cada oportunidade sem perder o histórico do atendimento.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">02</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Encontre o lead</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Use a busca ou os filtros para encontrar por nome, telefone, status ou filial. O filtro fica preservado quando você volta para a lista.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Abra o detalhe</p><p class="mt-1 text-sm leading-6 text-muted-foreground">No detalhe você vê contato, responsável, status, histórico, tarefas, cotações e documentos ligados à mesma oportunidade.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Escolha a próxima ação</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Inicie o atendimento, abra uma conversa, crie uma tarefa, prepare uma cotação ou registre uma observação.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Avance o status com contexto</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Atualize a etapa quando algo realmente mudar. Ao marcar uma perda, informe o motivo para manter a visão da corretora confiável.</p></div></li></ol><div class="mt-5 rounded-xl border border-primary/15 bg-primary/[0.05] px-4 py-3 text-sm leading-6 text-muted-foreground"><span class="font-medium text-foreground">Dica prática: </span>A melhor fila é a que termina com uma próxima ação clara para cada lead.</div><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/leads">Abrir Leads<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="conversas" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" variants="[object Object]" animate="[object Object]"><path d="M2 6L8.91302 9.91697C11.4616 11.361 12.5384 11.361 15.087 9.91697L22 6"></path><path d="M2.01577 13.4756C2.08114 16.5412 2.11383 18.0739 3.24496 19.2094C4.37608 20.3448 5.95033 20.3843 9.09883 20.4634C11.0393 20.5122 12.9607 20.5122 14.9012 20.4634C18.0497 20.3843 19.6239 20.3448 20.7551 19.2094C21.8862 18.0739 21.9189 16.5412 21.9842 13.4756C22.0053 12.4899 22.0053 11.5101 21.9842 10.5244C21.9189 7.45886 21.8862 5.92609 20.7551 4.79066C19.6239 3.65523 18.0497 3.61568 14.9012 3.53657C12.9607 3.48781 11.0393 3.48781 9.09882 3.53656C5.95033 3.61566 4.37608 3.65521 3.24495 4.79065C2.11382 5.92608 2.08114 7.45885 2.01576 10.5244C1.99474 11.5101 1.99475 12.4899 2.01577 13.4756Z"></path></svg></div></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Atendimento</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Conversas e atendimento</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Centralize a conversa com o cliente e mantenha o contexto do lead à mão.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">03</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Escolha uma conversa</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Pesquise pelo nome, telefone ou e-mail. A lista mostra a última mensagem e o status do atendimento.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Leia antes de responder</p><p class="mt-1 text-sm leading-6 text-muted-foreground">O histórico fica no centro da tela, enquanto o perfil do cliente reúne contato, responsável, plano e consentimento.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Use uma ação rápida</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Prepare uma mensagem sobre cotação, contrato ou plano. Revise o texto antes de enviar.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Responda pelo canal disponível</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Quando o WhatsApp estiver conectado, o envio fica disponível. Se não estiver, abra Configurações para conectar o canal.</p></div></li></ol><div class="mt-5 rounded-xl border border-primary/15 bg-primary/[0.05] px-4 py-3 text-sm leading-6 text-muted-foreground"><span class="font-medium text-foreground">Dica prática: </span>Uma mensagem bem contextualizada evita retrabalho: confira o lead e a última interação antes de escrever.</div><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/conversas">Abrir Conversas<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/integrations/whatsapp">Conectar WhatsApp<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="tarefas" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M17.0235 3.03358L16.0689 2.77924C13.369 2.05986 12.019 1.70018 10.9555 2.31074C9.89196 2.9213 9.53023 4.26367 8.80678 6.94841L7.78366 10.7452C7.0602 13.4299 6.69848 14.7723 7.3125 15.8298C7.92652 16.8874 9.27651 17.247 11.9765 17.9664L12.9311 18.2208C15.631 18.9401 16.981 19.2998 18.0445 18.6893C19.108 18.0787 19.4698 16.7363 20.1932 14.0516L21.2163 10.2548C21.9398 7.57005 22.3015 6.22768 21.6875 5.17016C21.0735 4.11264 19.7235 3.75295 17.0235 3.03358Z" stroke="currentColor" stroke-width="1.5"></path><path d="M16.8538 7.43306C16.8538 8.24714 16.1901 8.90709 15.3714 8.90709C14.5527 8.90709 13.889 8.24714 13.889 7.43306C13.889 6.61898 14.5527 5.95904 15.3714 5.95904C16.1901 5.95904 16.8538 6.61898 16.8538 7.43306Z" stroke="currentColor" stroke-width="1.5"></path><path d="M12 20.9463L11.0477 21.2056C8.35403 21.9391 7.00722 22.3059 5.94619 21.6833C4.88517 21.0608 4.52429 19.6921 3.80253 16.9547L2.78182 13.0834C2.06006 10.346 1.69918 8.97731 2.31177 7.89904C2.84167 6.96631 4 7.00027 5.5 7.00015" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path></svg></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Atendimento</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Tarefas e próximos passos</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Transforme cada decisão em uma ação com prazo, prioridade e responsável.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">04</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Crie a tarefa dentro do lead</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Assim ela já nasce ligada ao contexto certo e aparece para as pessoas responsáveis.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Dê um prazo realista</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Use o agendamento para que a equipe saiba quando agir. Prioridade urgente deve representar risco ou oportunidade imediata.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Acompanhe sua operação</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Na lista, veja o que está atrasado, quem está responsável e qual lead precisa de atenção.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Volte ao lead para decidir</p><p class="mt-1 text-sm leading-6 text-muted-foreground">A tarefa é um próximo passo, não uma tela isolada. Abra o lead para registrar o resultado.</p></div></li></ol><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/tarefas">Abrir Tarefas<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="documentos" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M16.5 2V5M7.5 2V5M12 2V5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M13 3.5H11C7.70017 3.5 6.05025 3.5 5.02513 4.52513C4 5.55025 4 7.20017 4 10.5V15C4 18.2998 4 19.9497 5.02513 20.9749C6.05025 22 7.70017 22 11 22H13C16.2998 22 17.9497 22 18.9749 20.9749C20 19.9497 20 18.2998 20 15V10.5C20 7.20017 20 5.55025 18.9749 4.52512C17.9497 3.5 16.2998 3.5 13 3.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M8 15H12M8 11H16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Atendimento</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Documentos e aprovações</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Saiba o que falta, envie arquivos e acompanhe a aprovação sem procurar em várias telas.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">05</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Veja o checklist aplicável</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Os documentos pedidos dependem da cotação, operadora e plano. Assim você evita pedir arquivos desnecessários.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Envie o arquivo correto</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Faça o upload pelo lead ou pela fila de documentos. O arquivo fica ligado ao requisito e ao cliente.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Acompanhe o resultado</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Gestores e Diretores podem aprovar ou rejeitar. Quando houver rejeição, corrija o arquivo e envie novamente.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Use ações em lote com cuidado</p><p class="mt-1 text-sm leading-6 text-muted-foreground">A aprovação em lote agiliza a operação, mas confira se todos os documentos selecionados pertencem ao mesmo contexto.</p></div></li></ol><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/documentos">Abrir Documentos<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="clientes-vendas" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M14.5 8.48584C13.6329 8.91937 11.1118 9.65364 8.63166 9.58043C7.98001 9.56119 7.5 9.00159 7.5 8.34966C7.5 7.82561 7.81029 7.34974 8.28079 7.11896C9.28416 6.62682 10.867 5.80431 12.2709 5.04501C13.1233 4.58403 13.5495 4.35353 13.8726 4.24442C14.7383 3.95206 15.4351 3.94086 16.3097 4.20526C16.6362 4.30393 17.0283 4.49997 17.8124 4.89206L18.7167 5.34419C18.7884 5.38005 18.8243 5.39798 18.861 5.41284C18.9555 5.45108 19.0553 5.47463 19.1569 5.4827C19.1964 5.48583 19.2365 5.48583 19.3167 5.48583C19.9522 5.48583 20.2699 5.48583 20.5302 5.5574C21.2102 5.74437 21.7415 6.27562 21.9284 6.9556C22 7.21589 22 7.53363 22 8.16912V13.7001C22 14.4102 21.4244 14.9858 20.7143 14.9858C20.5752 14.9858 20.4398 15.0309 20.3286 15.1144L20 15.3608C19.3066 15.8809 18.9599 16.1409 18.5624 16.2914C18.4871 16.3199 18.4108 16.3454 18.3335 16.3677C17.9251 16.4858 17.4917 16.4858 16.625 16.4858H14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M14.5 8.48438L17.5713 11.9628C18.0912 12.5347 18.0703 13.4141 17.5238 13.9606C16.9584 14.526 16.0416 14.526 15.4762 13.9606C16.0285 14.5129 16.0523 15.4321 15.5 15.9844C14.9477 16.5367 14.0523 16.5367 13.5 15.9844L13 15.4844C13.5523 16.0367 13.5523 16.9321 13 17.4844C12.4477 18.0367 11.5523 18.0367 11 17.4844C11.5523 18.0367 11.5523 18.9321 11 19.4844L10.9393 19.545C10.658 19.8263 10.2765 19.9844 9.87868 19.9844H9.75C9.26978 19.9844 8.80923 19.7936 8.46967 19.454L4.41421 15.3986C4.149 15.1334 3.78929 14.9844 3.41421 14.9844C2.63317 14.9844 2 14.3512 2 13.5702V9.48438C2 7.59876 2 6.65595 2.58579 6.07016C3.17157 5.48438 4.11438 5.48438 6 5.48438H11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Gestão</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Clientes e vendas</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Quando um lead vira venda, acompanhe o cliente ativo e o que acontece depois do fechamento.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">06</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Converta no momento certo</p><p class="mt-1 text-sm leading-6 text-muted-foreground">A conversão transforma o lead em cliente ativo e preserva o vínculo com o histórico comercial.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Consulte a carteira</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Em Clientes, veja quem já foi convertido e mantenha o acompanhamento organizado.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Acompanhe a venda</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Em Vendas, veja o valor, o plano e as parcelas de comissão associadas ao fechamento.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Cuide do pós-venda</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Alertas de renovação e aniversário aparecem nas notificações quando estiverem próximos do período de atenção.</p></div></li></ol><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/clientes">Abrir Clientes<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/vendas">Abrir Vendas<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="gestao-equipe" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M12 2H6C3.518 2 3 2.518 3 5V22H15V5C15 2.518 14.482 2 12 2Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path><path d="M18 8H15V22H21V11C21 8.518 20.482 8 18 8Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path><path d="M8 6L10 6M8 9L10 9M8 12L10 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M11.5 22V18C11.5 17.0572 11.5 16.5858 11.2071 16.2929C10.9142 16 10.4428 16 9.5 16H8.5C7.55719 16 7.08579 16 6.79289 16.2929C6.5 16.5858 6.5 17.0572 6.5 18V22" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Gestão</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Equipe, filiais e distribuição</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Organize quem atende, onde cada pessoa trabalha e como os leads entram na fila.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">07</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Cadastre a estrutura</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Crie filiais e convide Gestores ou Corretores com o papel adequado para cada pessoa.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Mantenha a disponibilidade atualizada</p><p class="mt-1 text-sm leading-6 text-muted-foreground">O status disponível ou pausado ajuda a distribuir novos leads para quem realmente pode atender.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Acompanhe a fila da filial</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Gestores trabalham no escopo da sua filial; Diretores têm a visão completa da corretora.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Corrija exceções rapidamente</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Quando um lead precisar de outro responsável, reatribua pelo detalhe e confira o impacto no próximo atendimento.</p></div></li></ol><div class="mt-5 rounded-xl border border-primary/15 bg-primary/[0.05] px-4 py-3 text-sm leading-6 text-muted-foreground"><span class="font-medium text-foreground">Dica prática: </span>Permissão e responsabilidade andam juntas: cada pessoa deve enxergar apenas o que precisa para trabalhar bem.</div><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/equipe">Abrir Equipe<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/equipe?visao=unidades">Abrir Unidades<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="distribuicao-leads" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5" animate="[object Object]" variants="[object Object]"></circle><path d="M20 21C20 16.5817 16.4183 13 12 13C7.58172 13 4 16.5817 4 21" variants="[object Object]" transition="[object Object]" animate="[object Object]"></path></svg></div></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Gestão</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Distribuição de leads</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Entenda como um lead sai da Inbox geral, chega à unidade e é atribuído a um corretor elegível.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">08</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Revise a Inbox geral</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Leads aguardando unidade ou corretor aparecem na área de distribuição. Selecione um ou vários para operar em lote.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Envie para uma unidade</p><p class="mt-1 text-sm leading-6 text-muted-foreground">O Diretor pode escolher qualquer unidade ativa que aceite leads. O Gestor opera somente na própria unidade.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Escolha a fila e o modo</p><p class="mt-1 text-sm leading-6 text-muted-foreground">A fila geral é criada para a unidade quando necessário. Filas automáticas procuram corretores disponíveis; filas manuais aguardam ação do Gestor.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Atribua ou distribua automaticamente</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Use Atribuir para escolher um corretor elegível ou Auto para aplicar capacidade e carga ativa. Corretores pausados não recebem novos leads.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">5</span><div class="min-w-0 pt-0.5"><p class="font-medium">Acompanhe o histórico</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Cada envio, atribuição, conflito e alteração fica registrado no histórico de distribuição e na auditoria do tenant.</p></div></li></ol><div class="mt-5 rounded-xl border border-primary/15 bg-primary/[0.05] px-4 py-3 text-sm leading-6 text-muted-foreground"><span class="font-medium text-foreground">Dica prática: </span>Se nenhum corretor aparecer, confira se ele está ativo, vinculado à unidade, disponível e dentro da capacidade configurada.</div><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/leads/distribuicao">Abrir distribuição<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/leads">Abrir Leads<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="comissoes-metas" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M15.1312 2.5C14.1462 2.17555 13.0936 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 10.9548 21.8396 9.94704 21.5422 9" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M17 12C17 14.7614 14.7614 17 12 17C9.23858 17 7 14.7614 7 12C7 9.23858 9.23858 7 12 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M19.5 4.5L12 12M19.5 4.5V2M19.5 4.5H22" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path></svg></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Gestão</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Comissões e metas</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Configure regras, acompanhe repasses e transforme objetivos comerciais em acompanhamento diário.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">09</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Defina a regra de comissão</p><p class="mt-1 text-sm leading-6 text-muted-foreground">O Diretor pode configurar percentuais por operadora, plano ou regra geral, incluindo parcelas futuras.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Acompanhe o cronograma</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Cada venda mostra as parcelas previstas, pendentes e pagas com suas datas de referência.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Registre o pagamento</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Diretores podem marcar uma parcela como paga e reverter a marcação se necessário.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Crie metas acompanháveis</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Configure objetivos por pessoa, equipe ou filial. Corretores acompanham o próprio progresso em Minha meta.</p></div></li></ol><div class="mt-5 rounded-xl border border-primary/15 bg-primary/[0.05] px-4 py-3 text-sm leading-6 text-muted-foreground"><span class="font-medium text-foreground">Dica prática: </span>Uma meta boa é específica e revisada durante o período; use o progresso para decidir a próxima ação, não apenas para olhar o resultado final.</div><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/configuracoes/comissoes">Abrir Comissões<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/metas">Abrir Metas<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/minha-meta">Minha meta<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="configuracoes-seguranca" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="overflow: visible;"><g variants="[object Object]" animate="[object Object]"><path d="M4 6H20M7 12H17M10 18H14"></path></g></svg></div></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Configuração</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Configurações e segurança</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Ajuste a identidade da corretora, integrações, acesso e proteção da conta.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">10</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Atualize a identidade</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Defina nome, logo e cor da corretora. A identidade aparece no ambiente de trabalho da equipe.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Conecte as integrações</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Gere e gerencie fontes de leads e configure o WhatsApp quando o canal estiver pronto.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Proteja seu acesso</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Revise sessões e ative a autenticação em duas etapas para aumentar a proteção da conta.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Confirme o papel de cada pessoa</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Permissões determinam o que cada usuário pode ver e alterar. Convide com o papel mínimo necessário.</p></div></li></ol><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/settings">Abrir Configurações<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/settings?tab=security">Segurança<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/settings?tab=integrations">Integrações<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="notificacoes" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" variants="[object Object]" animate="[object Object]" transition="[object Object]"><path d="M2.52992 14.7696C2.31727 16.1636 3.268 17.1312 4.43205 17.6134C8.89481 19.4622 15.1052 19.4622 19.5679 17.6134C20.732 17.1312 21.6827 16.1636 21.4701 14.7696C21.3394 13.9129 20.6932 13.1995 20.2144 12.5029C19.5873 11.5793 19.525 10.5718 19.5249 9.5C19.5249 5.35786 16.1559 2 12 2C7.84413 2 4.47513 5.35786 4.47513 9.5C4.47503 10.5718 4.41272 11.5793 3.78561 12.5029C3.30684 13.1995 2.66061 13.9129 2.52992 14.7696Z"></path><path d="M8 19C8.45849 20.7252 10.0755 22 12 22C13.9245 22 15.5415 20.7252 16 19"></path></svg></div></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Configuração</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Notificações e alertas</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Use os avisos para agir no momento certo, sem transformar o sistema em uma lista de ruídos.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">11</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Abra a central</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Veja alertas relacionados à sua carteira ou ao escopo da sua função.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Leia o contexto</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Cada aviso deve indicar o que aconteceu e qual tela ajuda a resolver a situação.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Aja pelo link de origem</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Volte diretamente ao lead, tarefa ou configuração relacionada para não perder tempo procurando.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Priorize urgências</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Leads sem contato, estagnados e eventos de pós-venda pedem atenção diferente de uma atualização informativa.</p></div></li></ol><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/notificacoes">Abrir Notificações<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article><article id="webhook-integracao" class="scroll-mt-24"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] overflow-hidden border-border bg-card shadow-none"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] border-b border-border/80 bg-muted/20 px-5 py-5 sm:px-6"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] text-primary"><span class="inline-flex shrink-0 items-center justify-center size-5" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M11.8013 6.48949L13.2869 5.00392C14.9596 3.3312 17.1495 2.63737 19.4671 2.52399C20.3686 2.47989 20.8193 2.45784 21.1807 2.81928C21.5422 3.18071 21.5201 3.63143 21.476 4.53289C21.3626 6.8505 20.6688 9.04042 18.9961 10.7131L17.5105 12.1987C16.2871 13.4221 15.9393 13.77 16.1961 15.097C16.4496 16.1107 16.6949 17.0923 15.9578 17.8294C15.0637 18.7235 14.2481 18.7235 13.354 17.8294L6.17058 10.646C5.27649 9.75188 5.27646 8.9363 6.17058 8.04219C6.90767 7.30509 7.88929 7.55044 8.90297 7.80389C10.23 8.06073 10.5779 7.71289 11.8013 6.48949Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path><path d="M2.5 21.5L7.5 16.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M8.5 21.5L10.5 19.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M2.5 15.5L4.5 13.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path><path d="M17.125 7H17M17.25 7C17.25 7.13807 17.1381 7.25 17 7.25C16.8619 7.25 16.75 7.13807 16.75 7C16.75 6.86193 16.8619 6.75 17 6.75C17.1381 6.75 17.25 6.86193 17.25 7Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></span><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">Configuração</p><div data-slot="card-title" class="font-sans font-semibold text-foreground mt-1 text-xl tracking-tight">Integração via Webhook (Landing Page)</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground mt-1 max-w-2xl leading-6">Configure um formulário externo para enviar leads automaticamente ao CorreTop via API.</div></div><span class="ml-auto hidden shrink-0 font-mono text-xs text-muted-foreground sm:block">12</span></div></div><div data-slot="card-content" class="p-0 px-5 py-5 sm:px-6"><ol class="space-y-0"><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">1</span><div class="min-w-0 pt-0.5"><p class="font-medium">Crie uma fonte de captura</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Em Configurações &gt; Integrações, clique em Nova fonte. Escolha o nome, a origem padrão (landing_page) e a filial de destino.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">2</span><div class="min-w-0 pt-0.5"><p class="font-medium">Copie o token gerado</p><p class="mt-1 text-sm leading-6 text-muted-foreground">O token completo (crt_live_...) é exibido apenas uma vez. Copie e guarde em local seguro.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">3</span><div class="min-w-0 pt-0.5"><p class="font-medium">Adicione o snippet no site</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Cole o script de inicialização antes do código do formulário. Defina a URL com o ID do tenant e o token.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span aria-hidden="true" class="absolute left-3.5 top-8 h-[calc(100%-1.25rem)] w-px bg-border"></span><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">4</span><div class="min-w-0 pt-0.5"><p class="font-medium">Configure o envio do formulário</p><p class="mt-1 text-sm leading-6 text-muted-foreground">No submit, monte o payload com name (obrigatório), phone (obrigatório), source (obrigatório) e campos opcionais como email e planInterest.</p></div></li><li class="relative flex gap-3 pb-5 last:pb-0"><span class="relative z-10 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background text-xs font-semibold tabular-nums text-muted-foreground">5</span><div class="min-w-0 pt-0.5"><p class="font-medium">Trate a resposta da API</p><p class="mt-1 text-sm leading-6 text-muted-foreground">Verifique se success é true. Em caso de erro, leia o code para entender o problema (422 = dados inválidos, 401 = token inválido).</p></div></li></ol><div class="mt-5 rounded-xl border border-primary/15 bg-primary/[0.05] px-4 py-3 text-sm leading-6 text-muted-foreground"><span class="font-medium text-foreground">Dica prática: </span>Use o header Idempotency-Key com um identificador único para evitar duplicação caso o cliente envie o formulário duas vezes.</div><div data-orientation="horizontal" role="separator" aria-orientation="horizontal" data-slot="separator" class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch my-5"></div><div class="flex flex-wrap gap-2"><a data-slot="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer border-border bg-card hover:bg-muted hover:border-border-strong text-foreground shadow-none h-7.5 gap-1.5 px-3 text-xs has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5" href="/settings?tab=integrations">Abrir Configurações<span class="inline-flex shrink-0 items-center justify-center"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span></a></div></div></div></article></div></div></div></main>"`;

exports[`telas atuais com a chave desligada > preservam o HTML legado 3`] = `
"<main class="mx-auto min-h-full w-full max-w-4xl bg-background p-4 lg:p-6"><section class="mb-8"><span transition="[object Object]" class="relative inline-flex shrink-0 items-center justify-center overflow-hidden border tabular-nums select-none transition-colors duration-[var(--duration-fast)] h-6 px-2 text-[11px] whitespace-nowrap rounded-full font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 mb-3 gap-1.5 border-primary/20 bg-primary/[0.05] text-primary"><span class="relative z-10 inline-flex overflow-hidden"><span data-badge-label="true" variants="[object Object]" initial="initial" animate="animate" exit="exit" class="inline-flex items-center gap-1.5">Guia de Integração</span></span></span><h1 class="text-3xl font-semibold tracking-tight">Integração via Webhook</h1><p class="mt-2 max-w-2xl text-base leading-7 text-muted-foreground">Envie leads automaticamente do seu site ou landing page para a plataforma usando nossa API REST.</p></section><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border p-[var(--size-spacing-05)] shadow-none mb-8 border-primary/20 bg-primary/[0.03]"><div data-slot="card-header" class="group/card-header grid auto-rows-min items-start gap-1.5 p-0 pb-1 has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto]"><div data-slot="card-title" class="font-sans font-semibold tracking-tight text-foreground text-base">Início rápido</div><div data-slot="card-description" class="font-sans text-xs text-muted-foreground">Cole este snippet no seu site e comece a enviar leads em 2 minutos.</div></div><div data-slot="card-content" class="p-0"><div class="relative rounded-xl border border-border bg-muted/40"><div class="flex items-center justify-between border-b border-border px-4 py-2"><span class="text-xs font-medium text-muted-foreground">index.html</span><button data-slot="button" type="button" class="ct-press group/button inline-flex shrink-0 items-center justify-center rounded-full border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow,scale] duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 motion-reduce:transition-none [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 cursor-pointer hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&amp;_svg:not([class*='size-'])]:size-3.5 h-7 gap-1.5 px-2 text-xs"><span class="relative inline-flex size-3.5 items-center justify-center"><span class="inline-flex size-full items-center justify-center [&amp;>svg]:size-full" initial="[object Object]" animate="[object Object]" exit="[object Object]" transition="[object Object]"><span class="inline-flex shrink-0 items-center justify-center size-3.5" animate="[object Object]" transition="[object Object]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" color="currentColor" class="size-full"><path d="M9 15C9 12.1716 9 10.7574 9.87868 9.87868C10.7574 9 12.1716 9 15 9L16 9C18.8284 9 20.2426 9 21.1213 9.87868C22 10.7574 22 12.1716 22 15V16C22 18.8284 22 20.2426 21.1213 21.1213C20.2426 22 18.8284 22 16 22H15C12.1716 22 10.7574 22 9.87868 21.1213C9 20.2426 9 18.8284 9 16L9 15Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M16.9999 9C16.9975 6.04291 16.9528 4.51121 16.092 3.46243C15.9258 3.25989 15.7401 3.07418 15.5376 2.90796C14.4312 2 12.7875 2 9.5 2C6.21252 2 4.56878 2 3.46243 2.90796C3.25989 3.07417 3.07418 3.25989 2.90796 3.46243C2 4.56878 2 6.21252 2 9.5C2 12.7875 2 14.4312 2.90796 15.5376C3.07417 15.7401 3.25989 15.9258 3.46243 16.092C4.51121 16.9528 6.04291 16.9975 9 16.9999" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></span></span>Copiar</button></div><pre class="overflow-x-auto p-4 text-[12px] leading-6 text-foreground"><code>&lt;!-- 1. Snippet de Inicialização (antes do &lt;/body&gt;) --&gt;
&lt;script&gt;
  window.CORRETOP_HUB_URL = "https://crm.ancorasaude.cloud/api/webhooks/leads";
  window.CORRETOP_HUB_TOKEN = "crt_live_SEU_TOKEN";
&lt;/script&gt;

&lt;!-- 2. Formulário --&gt;
&lt;form id="lead-form"&gt;
  &lt;input name="name" placeholder="Nome completo" required /&gt;
  &lt;input name="phone" placeholder="Telefone com DDD" required /&gt;
  &lt;input name="email" type="email" placeholder="E-mail (opcional)" /&gt;
  &lt;button type="submit"&gt;Enviar&lt;/button&gt;
&lt;/form&gt;

&lt;!-- 3. Script de envio --&gt;
&lt;script&gt;
  document.getElementById("lead-form").addEventListener("submit", async (e) =&gt; {
    e.preventDefault();
    const fd = new FormData(e.target);

    const response = await fetch(window.CORRETOP_HUB_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": "Bearer " + window.CORRETOP_HUB_TOKEN,
        "Idempotency-Key": "lead-" + Date.now()
      },
      body: JSON.stringify({
        name: fd.get("name"),
        phone: fd.get("phone"),
        email: fd.get("email") || undefined,
        source: "landing-page"
      })
    });

    const result = await response.json();
    if (result.success) {
      console.log("Lead criado:", result.data.leadId);
    } else {
      console.error("Erro:", result.error);
    }
  });
&lt;/script&gt;</code></pre></div></div></div><section class="mb-8"><h2 class="mb-4 text-xl font-semibold">Passo a passo</h2><div class="space-y-4"><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border bg-card p-[var(--size-spacing-05)] shadow-none border-border"><div data-slot="card-content" class="flex gap-4 p-5"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] font-mono text-sm font-semibold text-primary">01</span><div class="min-w-0 flex-1"><h3 class="font-semibold">Criar fonte de captura</h3><p class="mt-1 text-sm text-muted-foreground">Acesse Configurações &gt; Integrações e clique em Nova fonte.</p><ul class="mt-3 space-y-1.5"><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>Escolha um nome descritivo (ex: Landing Page - Saúde)</li><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>Selecione a origem padrão: Landing page</li><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>Selecione a filial de destino (opcional)</li><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>Clique em Gerar token</li></ul></div></div></div><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border bg-card p-[var(--size-spacing-05)] shadow-none border-border"><div data-slot="card-content" class="flex gap-4 p-5"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] font-mono text-sm font-semibold text-primary">02</span><div class="min-w-0 flex-1"><h3 class="font-semibold">Copiar o token</h3><p class="mt-1 text-sm text-muted-foreground">O token completo é exibido apenas uma vez. Copie e guarde em local seguro.</p><ul class="mt-3 space-y-1.5"><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>O token começa com crt_live_</li><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>Nunca compartilhe publicamente</li><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>Se perder, gere um novo em Configurações</li></ul></div></div></div><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border bg-card p-[var(--size-spacing-05)] shadow-none border-border"><div data-slot="card-content" class="flex gap-4 p-5"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] font-mono text-sm font-semibold text-primary">03</span><div class="min-w-0 flex-1"><h3 class="font-semibold">Adicionar snippet no site</h3><p class="mt-1 text-sm text-muted-foreground">Cole o script antes do código do formulário no seu HTML.</p><ul class="mt-3 space-y-1.5"><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>Substitua SEU_TENANT_ID pelo ID da sua corretora</li><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>Substitua crt_live_SEU_TOKEN pelo token copiado</li><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>O snippet deve vir ANTES do script do formulário</li></ul></div></div></div><div data-slot="card" data-variant="default" data-size="default" class="group/card flex min-w-0 flex-col text-card-foreground gap-[var(--size-spacing-04)] rounded-[var(--radius-card)] border bg-card p-[var(--size-spacing-05)] shadow-none border-border"><div data-slot="card-content" class="flex gap-4 p-5"><span class="grid size-10 shrink-0 place-items-center rounded-xl border border-primary/15 bg-primary/[0.07] font-mono text-sm font-semibold text-primary">04</span><div class="min-w-0 flex-1"><h3 class="font-semibold">Configurar envio do formulário</h3><p class="mt-1 text-sm text-muted-foreground">No submit, monte o payload com os campos obrigatórios.</p><ul class="mt-3 space-y-1.5"><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 12H19M19 12L15 8M19 12L15 16"></path></g></svg></div></span>name (obrigatório) — Nome completo do lead</li><li class="flex items-start gap-2 text-sm text-muted-foreground"><span class="inline-flex items-center justify-center mt-1 size-3 shrink-0 text-primary"><div class="inline-flex size-full items-center justify-center [&amp;_svg]:size-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g variants="[object Object]" animate="[object Object]"><path d="M5 